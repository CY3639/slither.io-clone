{
  "name": "n5528712-a3-game-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative multiplayer Slither.io world server (one world per process)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "EVENT_SINK=http EVENT_HTTP_URL=http://localhost:8090/events LOCAL_API_URL=http://localhost:8090 STATIC_DIR=../client node src/index.js",
    "test": "node --test 'test/**/*.test.js'",
    "dev:solo": "STATIC_DIR=../client LOG_LEVEL=info METRICS_INTERVAL_MS=30000 node src/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "ws": "^8.22.0"
  }
}
